{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-location-finder-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 72%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-location-finder-container-{{ ai_gen_id }} {
    max-width: 1000px;
    margin: 0 auto;
  }

  .ai-location-finder-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 40px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-location-finder-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .ai-location-finder-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-location-finder-state-{{ ai_gen_id }} {
    font-size: {{ block.settings.state_size }}px;
    font-weight: 600;
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-location-finder-location-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-location-finder-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.location_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-location-finder-name-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-location-finder-name-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.location_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-location-finder-address-{{ ai_gen_id }},
  .ai-location-finder-phone-{{ ai_gen_id }} {
    font-size: {{ block.settings.details_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-location-finder-address-link-{{ ai_gen_id }},
  .ai-location-finder-phone-link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-location-finder-address-link-{{ ai_gen_id }}:hover,
  .ai-location-finder-phone-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-location-finder-button-wrapper-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 40px;
  }

  .ai-location-finder-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-location-finder-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-location-finder-columns-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-location-finder-{{ ai_gen_id }} {
      padding: 30px 15px;
    }

    .ai-location-finder-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-location-finder-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
      margin-bottom: 30px;
    }
  }
{% endstyle %}

<location-finder-{{ ai_gen_id }}
  class="ai-location-finder-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-location-finder-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-location-finder-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-location-finder-columns-{{ ai_gen_id }}">
      <div class="ai-location-finder-column-{{ ai_gen_id }}">
        {% if block.settings.state_1 != blank %}
          <div class="ai-location-finder-state-{{ ai_gen_id }} {{block.settings.heading_tag}}">{{ block.settings.state_1 }}</div>
        {% endif %}

        {% if block.settings.location_1_1_name != blank %}
          <div class="ai-location-finder-location-{{ ai_gen_id }}">
            {% if block.settings.location_1_1_name_url != blank %}
              <a
                href="{{ block.settings.location_1_1_name_url }}"
                class="ai-location-finder-name-{{ ai_gen_id }}"
              >
                {{ block.settings.location_1_1_name }}
              </a>
            {% else %}
              <div class="ai-location-finder-name-text-{{ ai_gen_id }}">{{ block.settings.location_1_1_name }}</div>
            {% endif %}
            {% if block.settings.location_1_1_address != blank %}
              <p class="ai-location-finder-address-{{ ai_gen_id }}">
                {% if block.settings.location_1_1_address_url != blank %}
                  <a
                    href="{{ block.settings.location_1_1_address_url }}"
                    class="ai-location-finder-address-link-{{ ai_gen_id }}"
                  >
                    {{ block.settings.location_1_1_address }}
                  </a>
                {% else %}
                  {{ block.settings.location_1_1_address }}
                {% endif %}
              </p>
            {% endif %}
            {% if block.settings.location_1_1_phone != blank %}
              <p class="ai-location-finder-phone-{{ ai_gen_id }}">
                {% if block.settings.location_1_1_phone_url != blank %}
                  <a
                    href="{{ block.settings.location_1_1_phone_url }}"
                    class="ai-location-finder-phone-link-{{ ai_gen_id }}"
                  >
                    {{ block.settings.location_1_1_phone }}
                  </a>
                {% else %}
                  <a
                    href="tel:{{ block.settings.location_1_1_phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}"
                    class="ai-location-finder-phone-link-{{ ai_gen_id }}"
                  >
                    {{ block.settings.location_1_1_phone }}
                  </a>
                {% endif %}
              </p>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.location_1_2_name != blank %}
          <div class="ai-location-finder-location-{{ ai_gen_id }}">
            {% if block.settings.location_1_2_name_url != blank %}
              <a
                href="{{ block.settings.location_1_2_name_url }}"
                class="ai-location-finder-name-{{ ai_gen_id }}"
              >
                {{ block.settings.location_1_2_name }}
              </a>
            {% else %}
              <div class="ai-location-finder-name-text-{{ ai_gen_id }}">{{ block.settings.location_1_2_name }}</div>
            {% endif %}
            {% if block.settings.location_1_2_address != blank %}
              <p class="ai-location-finder-address-{{ ai_gen_id }}">
                {% if block.settings.location_1_2_address_url != blank %}
                  <a
                    href="{{ block.settings.location_1_2_address_url }}"
                    class="ai-location-finder-address-link-{{ ai_gen_id }}"
                  >
                    {{ block.settings.location_1_2_address }}
                  </a>
                {% else %}
                  {{ block.settings.location_1_2_address }}
                {% endif %}
              </p>
            {% endif %}
            {% if block.settings.location_1_2_phone != blank %}
              <p class="ai-location-finder-phone-{{ ai_gen_id }}">
                {% if block.settings.location_1_2_phone_url != blank %}
                  <a
                    href="{{ block.settings.location_1_2_phone_url }}"
                    class="ai-location-finder-phone-link-{{ ai_gen_id }}"
                  >
                    {{ block.settings.location_1_2_phone }}
                  </a>
                {% else %}
                  <a
                    href="tel:{{ block.settings.location_1_2_phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}"
                    class="ai-location-finder-phone-link-{{ ai_gen_id }}"
                  >
                    {{ block.settings.location_1_2_phone }}
                  </a>
                {% endif %}
              </p>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="ai-location-finder-column-{{ ai_gen_id }}">
        {% if block.settings.state_2 != blank %}
          <div class="ai-location-finder-state-{{ ai_gen_id }}" style="font-size: 1.3rem;">{{ block.settings.state_2 }}</div>
        {% endif %}

        {% for i in (1..3) %}
          {% liquid
            assign name_key = 'location_2_' | append: i | append: '_name'
            assign name_url_key = 'location_2_' | append: i | append: '_name_url'
            assign address_key = 'location_2_' | append: i | append: '_address'
            assign address_url_key = 'location_2_' | append: i | append: '_address_url'
            assign phone_key = 'location_2_' | append: i | append: '_phone'
            assign phone_url_key = 'location_2_' | append: i | append: '_phone_url'

            assign location_name = block.settings[name_key]
            assign location_name_url = block.settings[name_url_key]
            assign location_address = block.settings[address_key]
            assign location_address_url = block.settings[address_url_key]
            assign location_phone = block.settings[phone_key]
            assign location_phone_url = block.settings[phone_url_key]
          %}

          {% if location_name != blank %}
            <div class="ai-location-finder-location-{{ ai_gen_id }}">
              {% if location_name_url != blank %}
                <a
                  href="{{ location_name_url }}"
                  class="ai-location-finder-name-{{ ai_gen_id }}"
                >
                  {{ location_name }}
                </a>
              {% else %}
                <div class="ai-location-finder-name-text-{{ ai_gen_id }}">{{ location_name }}</div>
              {% endif %}
              {% if location_address != blank %}
                <p class="ai-location-finder-address-{{ ai_gen_id }}">
                  {% if location_address_url != blank %}
                    <a
                      href="{{ location_address_url }}"
                      class="ai-location-finder-address-link-{{ ai_gen_id }}"
                    >
                      {{ location_address }}
                    </a>
                  {% else %}
                    {{ location_address }}
                  {% endif %}
                </p>
              {% endif %}
              {% if location_phone != blank %}
                <p class="ai-location-finder-phone-{{ ai_gen_id }}">
                  {% if location_phone_url != blank %}
                    <a
                      href="{{ location_phone_url }}"
                      class="ai-location-finder-phone-link-{{ ai_gen_id }}"
                    >
                      {{ location_phone }}
                    </a>
                  {% else %}
                    <a
                      href="tel:{{ location_phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}"
                      class="ai-location-finder-phone-link-{{ ai_gen_id }}"
                    >
                      {{ location_phone }}
                    </a>
                  {% endif %}
                </p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ai-location-finder-column-{{ ai_gen_id }}">
        {% if block.settings.state_3 != blank %}
          <div class="ai-location-finder-state-{{ ai_gen_id }}" style="font-size: 1.3rem;">{{ block.settings.state_3 }}</div>
        {% endif %}

        {% for i in (1..5) %}
          {% liquid
            assign name_key = 'location_3_' | append: i | append: '_name'
            assign name_url_key = 'location_3_' | append: i | append: '_name_url'
            assign address_key = 'location_3_' | append: i | append: '_address'
            assign address_url_key = 'location_3_' | append: i | append: '_address_url'
            assign phone_key = 'location_3_' | append: i | append: '_phone'
            assign phone_url_key = 'location_3_' | append: i | append: '_phone_url'

            assign location_name = block.settings[name_key]
            assign location_name_url = block.settings[name_url_key]
            assign location_address = block.settings[address_key]
            assign location_address_url = block.settings[address_url_key]
            assign location_phone = block.settings[phone_key]
            assign location_phone_url = block.settings[phone_url_key]
          %}

          {% if location_name != blank %}
            <div class="ai-location-finder-location-{{ ai_gen_id }}">
              {% if location_name_url != blank %}
                <a
                  href="{{ location_name_url }}"
                  class="ai-location-finder-name-{{ ai_gen_id }}"
                >
                  {{ location_name }}
                </a>
              {% else %}
                <div class="ai-location-finder-name-text-{{ ai_gen_id }}">{{ location_name }}</div>
              {% endif %}
              {% if location_address != blank %}
                <p class="ai-location-finder-address-{{ ai_gen_id }}">
                  {% if location_address_url != blank %}
                    <a
                      href="{{ location_address_url }}"
                      class="ai-location-finder-address-link-{{ ai_gen_id }}"
                    >
                      {{ location_address }}
                    </a>
                  {% else %}
                    {{ location_address }}
                  {% endif %}
                </p>
              {% endif %}
              {% if location_phone != blank %}
                <p class="ai-location-finder-phone-{{ ai_gen_id }}">
                  {% if location_phone_url != blank %}
                    <a
                      href="{{ location_phone_url }}"
                      class="ai-location-finder-phone-link-{{ ai_gen_id }}"
                    >
                      {{ location_phone }}
                    </a>
                  {% else %}
                    <a
                      href="tel:{{ location_phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}"
                      class="ai-location-finder-phone-link-{{ ai_gen_id }}"
                    >
                      {{ location_phone }}
                    </a>
                  {% endif %}
                </p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if block.settings.button_label != blank and block.settings.button_url != blank %}
      <div class="ai-location-finder-button-wrapper-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.button_url }}"
          class="ai-location-finder-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</location-finder-{{ ai_gen_id }}>

<script>
  (function() {
    class LocationFinder{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('location-finder-{{ ai_gen_id }}', LocationFinder{{ ai_gen_id }});
  })();
</script>

