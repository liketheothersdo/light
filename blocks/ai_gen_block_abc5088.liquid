{% doc %}
  @prompt
    Create a heading with a line break between three lines of text, displaying "" on the first line and "" on the second line, add a 3rd line 
    

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
  }

  .ai-split-heading__container-{{ ai_gen_id }} {
    display: inline-block;
  }

  .ai-split-heading__line-{{ ai_gen_id }} {
    display: block;
    font-family: {{ block.settings.font | font_face }};
    font-weight: {{ block.settings.font.weight }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-split-heading__line-1-{{ ai_gen_id }} {
    font-size: {{ block.settings.line_1_size }}px;
    color: {{ block.settings.line_1_color }};
    margin-bottom: {{ block.settings.line_spacing }}px;
  }

  .ai-split-heading__line-2-{{ ai_gen_id }} {
    font-size: {{ block.settings.line_2_size }}px;
    color: {{ block.settings.line_2_color }};
    margin-bottom: {{ block.settings.line_spacing }}px;
  }

  .ai-split-heading__line-3-{{ ai_gen_id }} {
    font-size: {{ block.settings.line_3_size }}px;
    color: {{ block.settings.line_3_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-split-heading__line-1-{{ ai_gen_id }} {
      font-size: {{ block.settings.line_1_size_mobile }}px;
    }

    .ai-split-heading__line-2-{{ ai_gen_id }} {
      font-size: {{ block.settings.line_2_size_mobile }}px;
    }

    .ai-split-heading__line-3-{{ ai_gen_id }} {
      font-size: {{ block.settings.line_3_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-split-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-heading__container-{{ ai_gen_id }}">
    <{{ block.settings.heading_tag }} class="ai-split-heading__line-{{ ai_gen_id }} ai-split-heading__line-1-{{ ai_gen_id }}">
      {{ block.settings.line_1_text }}
    </{{ block.settings.heading_tag }}>
    <{{ block.settings.heading_tag }} class="ai-split-heading__line-{{ ai_gen_id }} ai-split-heading__line-2-{{ ai_gen_id }}">
      {{ block.settings.line_2_text }}
    </{{ block.settings.heading_tag }}>
    {% if block.settings.line_3_text != blank %}
      <{{ block.settings.heading_tag }} class="ai-split-heading__line-{{ ai_gen_id }} ai-split-heading__line-3-{{ ai_gen_id }}">
        {{ block.settings.line_3_text }}
      </{{ block.settings.heading_tag }}>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Split Heading",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "line_1_text",
      "label": "First line text",
      "default": "first linr"
    },
    {
      "type": "text",
      "id": "line_2_text",
      "label": "Second line text",
      "default": "second line"
    },
    {
      "type": "text",
      "id": "line_3_text",
      "label": "Third line text",
      "default": "third line"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "sans-serif"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "line_spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space between lines",
      "default": 10
    },
    {
      "type": "header",
      "content": "First Line"
    },
    {
      "type": "range",
      "id": "line_1_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 40
    },
    {
      "type": "range",
      "id": "line_1_size_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 28
    },
    {
      "type": "color",
      "id": "line_1_color",
      "label": "Text color",
      "default": "#0e0e0e"
    },
    {
      "type": "header",
      "content": "Second Line"
    },
    {
      "type": "range",
      "id": "line_2_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 48
    },
    {
      "type": "range",
      "id": "line_2_size_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 32
    },
    {
      "type": "color",
      "id": "line_2_color",
      "label": "Text color",
      "default": "#bc9a64"
    },
    {
      "type": "header",
      "content": "Third Line"
    },
    {
      "type": "range",
      "id": "line_3_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 36
    },
    {
      "type": "range",
      "id": "line_3_size_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 24
    },
    {
      "type": "color",
      "id": "line_3_color",
      "label": "Text color",
      "default": "#0e0e0e"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Split Heading"
    }
  ]
}
{% endschema %}