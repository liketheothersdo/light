{% doc %}
  @prompt
    Create a heading with a line break between three lines of text, displaying "LIMITED TIME SPA OFFERS" on the first line, "MEMORIAL DAY WEEKEND" on the second line and "BOGO 75% OFF SALE!" on the third line. Each line can have a different font size 

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multiline-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.bottom_margin }}px;
  }

  .ai-multiline-heading-{{ ai_gen_id }} .line-1 {
    display: block;
    font-size: {{ block.settings.line_1_font_size }}px;
    font-weight: {{ block.settings.line_1_font_weight }};
    color: {{ block.settings.line_1_color }};
    margin-bottom: {{ block.settings.line_spacing }}px;
  }

  .ai-multiline-heading-{{ ai_gen_id }} .line-2 {
    display: block;
    font-size: {{ block.settings.line_2_font_size }}px;
    font-weight: {{ block.settings.line_2_font_weight }};
    color: {{ block.settings.line_2_color }};
    margin-bottom: {{ block.settings.line_spacing }}px;
  }

  .ai-multiline-heading-{{ ai_gen_id }} .line-3 {
    display: block;
    font-size: {{ block.settings.line_3_font_size }}px;
    font-weight: {{ block.settings.line_3_font_weight }};
    color: {{ block.settings.line_3_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-multiline-heading-{{ ai_gen_id }} .line-1 {
      font-size: {{ block.settings.line_1_font_size_mobile }}px;
    }

    .ai-multiline-heading-{{ ai_gen_id }} .line-2 {
      font-size: {{ block.settings.line_2_font_size_mobile }}px;
    }

    .ai-multiline-heading-{{ ai_gen_id }} .line-3 {
      font-size: {{ block.settings.line_3_font_size_mobile }}px;
    }
  }
{% endstyle %}

<{{ block.settings.heading_tag }} class="ai-multiline-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <span class="line-1">{{ block.settings.line_1_text }}</span>
  <span class="line-2">{{ block.settings.line_2_text }}</span>
  <span class="line-3">{{ block.settings.line_3_text }}</span>
</{{ block.settings.heading_tag }}>

