    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "tag_border_color",
      "label": "Tag border",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
