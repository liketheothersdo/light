      "default": 30
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "content_margin",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Content margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "author_section_margin",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "px",
