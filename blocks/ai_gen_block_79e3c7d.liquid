{% schema %}
{
  "name": "Google rating widget",
  "settings": [
    {
      "type": "header",
      "content": "Rating content"
    },
    {
      "type": "text",
      "id": "widget_title",
      "label": "Widget title",
      "default": "Google Reviews"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating score",
      "default": "4.6"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Number of reviews",
      "default": "1853"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "select",
      "id": "position_type",
      "label": "Position type",
      "options": [
        {
          "value": "absolute",
          "label": "Absolute"
        },
        {
          "value": "fixed",
          "label": "Fixed"
        }
      ],
      "default": "absolute"
    },
    {
      "type": "range",
      "id": "top_position",
      "min": -200,
      "max": 500,
      "step": 25,
      "unit": "px",
      "label": "Top position",
      "default": 250
    },
    {
      "type": "range",
      "id": "left_position",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Left position",
      "default": 80
    },
    {
      "type": "range",
      "id": "right_position",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Right position",
      "default": 100
    },
    {
      "type": "range",
      "id": "z_index",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Z-index",
      "default": 2
    },
    {
      "type": "header",
      "content": "Mobile position"
    },
    {
      "type": "checkbox",
      "id": "display_hide",
      "label": "hide",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_top_position",
      "min": 300,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Top position",
      "default": 400
    },
    {
      "type": "range",
      "id": "mobile_left_position",
      "min": 300,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Left position",
      "default": 400
    },
    {
      "type": "range",
      "id": "mobile_right_position",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Right position",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_bottom_position",
      "min": 0,
      "max": 600,
      "step": 25,
      "unit": "px",
      "label": "Bottom position",
      "default": 0
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fefefe"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0e0e0e"
    },
    {
      "type": "color",
      "id": "button_color",
