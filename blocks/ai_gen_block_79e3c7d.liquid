{% assign gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
.overlapping-wrapper {
    position: relative;
    height: fit-content;
  }

  .google-rating-widget-{{ gen_id }} {
    position: {{ block.settings.position_type }};
    {% if block.settings.position_type == 'absolute' %}
      top: {{ block.settings.top_position }}px;
      right: {{ block.settings.right_position }}px;
    {% endif %}
    display: flex;
    flex-direction: column;
    align-items: center;
    height: fit-content;
    width: fit-content;
    max-width: {{ block.settings.max_width }}px;
    z-index: {{ block.settings.z_index }};
    background-color: {{ block.settings.background_color }};
    opacity: {{ block.settings.opacity }};
    color: {{ block.settings.text_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(188, 154, 100, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    font-family: 'Interstate', sans-serif;
  }

.google-rating-logo-{{ gen_id }} {
    display: flex;
	  justify-content: center;
	  align-items: center;
	  padding: 0 0 5px 10px;
	  width: 36px;
	  height: 36px;
	  margin-right: 8px;
  }

.stars-container-{{ gen_id }} {
	display: flex;
	margin-bottom: 0;
}

.stars {
	width: {{ block.settings.star_size }}px;
  height: {{ block.settings.star_size }}px;
	opacity: 0;
	transform: scale(0.8);
}

.loaded .stars {
	animation: fadeIn 1s forwards ease-out;
}

.loaded .stars:nth-child(1) {
	animation-delay: 0.2s;
}
.loaded .stars:nth-child(2) {
	animation-delay: 0.3s;
}
.loaded .stars:nth-child(3) {
	animation-delay: 0.4s;
}
.loaded .stars:nth-child(4) {
	animation-delay: 0.5s;
}
.loaded .stars:nth-child(5) {
	animation-delay: 0.6s;
}

.stars-background {
	fill: {{ block.settings.empty_star_color }};
}

.stars-foreground {
	fill: url(#gold-gradient);
	filter: url(#chisel);
	clip-path: inset(0 100% 0 0);
}

.loaded .stars-foreground {
	animation-duration: 1.5s;
	animation-fill-mode: forwards;
	animation-timing-function: ease-in-out;
	animation-delay: 0.7s;
}

.loaded .stars:nth-child(-n + 4) .stars-foreground {
	animation-name: fillFullStar;
}

.loaded .stars:nth-child(5) .stars-foreground {
	animation-name: fillPartialStar;
}

.rating-value-{{ gen_id }} {
	font-size: {{ block.settings.score_font_size }}px;
	font-weight: bold;
	color: {{ block.settings.score_font_color }};
	margin-right: 10px;
	margin-bottom: 0;
}

.review-cta,
.review-cta-{{ gen_id }} {
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 0.9rem;
  margin: 2rem 0;
}

.reviews-summary-{{ gen_id }} {
	display: flex;
	align-items: center;
	margin-bottom: 5px;
	color: {{ block.settings.secondary_font_color }};
	font-size: {{ block.settings.secondary_font_size }}px;
}

.review-controls-{{ gen_id }} {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  width: 100%;
  text-align: center;
}

.review-label-{{ gen_id }} {
  font-size: 1rem;
  font-weight: 600;
  line-height: 1;
  color: {{ block.settings.secondary_font_color }};
  white-space: nowrap;
  margin-top: 1rem;
}

.review-select-{{ gen_id }} {
  width: 100%;
  max-width: 190px;
  min-height: 30px;
  border-radius: 9999px;
  border: 1px solid {{ block.settings.button_color }};
  background: {{ block.settings.button_color }};
  color: {{ block.settings.score_font_color }};
  font-size: 1.2rem;
  font-weight: 700;
  line-height: 1;
  padding: 0.45rem 1.6rem;
  text-align: center;
  text-align-last: center;
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(188, 154, 100, 0.18);
  background-image: linear-gradient(45deg, transparent 50%, #ffffff 50%), linear-gradient(135deg, #ffffff 50%, transparent 50%);
  background-position: calc(100% - 14px) 50%, calc(100% - 9px) 50%;
  background-size: 5px 5px, 5px 5px;
  background-repeat: no-repeat;
  transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.review-select-{{ gen_id }}:hover {
  background-color: {{ block.settings.button_hover_color }};
  border-color: {{ block.settings.button_hover_color }};
  box-shadow: 0 4px 10px rgba(188, 154, 100, 0.22);
}

.cta-button-{{ gen_id }} {
	background-color: {{ block.settings.button_color }};
	color: {{ block.settings.score_font_color }};
	text-decoration: none;
	padding: 5px 10px;
	border-radius: 5px;
	font-weight: bold;
	transition: {{ block.settings.button_color }} 0.3s;
}

@keyframes fadeIn {
	to {
		opacity: 1;
		transform: scale(1);
	}
}

@keyframes fillFullStar {
	from {
		clip-path: inset(0 100% 0 0);
	}
	to {
		clip-path: inset(0 0% 0 0);
	}
}

@keyframes fillPartialStar {
	from {
		clip-path: inset(0 100% 0 0);
	}
	to {
		clip-path: inset(0 40% 0 0);
	}
}

  

  /* For mobile, you may want to reduce the overlap to prevent crowding */
  @media (max-width: 768px) {
    .overlapping-content {
      top: -25px;
      width: 90%;
    }
  }



  @media screen and (max-width: 768px) {
    .google-rating-widget-{{ gen_id }} {
      {% if block.settings.display_hide %}
        display: none;
      {% else %}
      {% if block.settings.mobile_max_width != blank and block.settings.mobile_max_width != 0 %}
        max-width: {{ block.settings.mobile_max_width }}px;
      {% endif %}
      {% if block.settings.mobile_padding != blank and block.settings.mobile_padding != 0 %}
        padding: {{ block.settings.mobile_padding }}px;
      {% endif %}
      {% if block.settings.position_type == 'absolute' or block.settings.position_type == 'fixed' %}
        {% if block.settings.mobile_top_position != blank and block.settings.mobile_top_position != 0 %}
          top: {{ block.settings.mobile_top_position }}px;
        {% endif %}
        {% if block.settings.mobile_left_position != blank and block.settings.mobile_left_position != 0 %}
          left: {{ block.settings.mobile_left_position }}px;
        {% endif %}
        {% if block.settings.mobile_right_position != blank and block.settings.mobile_right_position != 0 %}
          right: {{ block.settings.mobile_right_position }}px;
        {% endif %}
        {% if block.settings.mobile_bottom_position != blank and block.settings.mobile_bottom_position != 0 %}
          bottom: {{ block.settings.mobile_bottom_position }}px;
        {% endif %}
      {% endif %}
    {% endif %}
  }
}

@media screen and (max-width: 600px) {
    .google-rating-widget-{{ gen_id }} {
      display: none; 
    }
  }
{% endstyle %}

