.tk-interstate {
    font-family: "interstate", sans-serif;
}

@font-face {
  font-family: 'interstate-fallback';
  src: local("sans-serif");
  size-adjust: 53.479%;
  ascent-override: 80%;
  descent-override: 20%;
  line-gap-override: 20%;
}

:root {
  --font-body-family: "interstate", "interstate-fallback", sans-serif;
  --font-body-style: normal;
  --font-body-weight: 400;
  --font-body-weight-bold: 700;

  --font-heading-family: "interstate", "interstate-fallback", sans-serif;
  --font-heading-style: normal;
  --font-heading-weight: 700;
}