<link rel="stylesheet" href="{{ 'template_ticker.css' | asset_url }}">

<style>
    .testimonial-slider-section .slick-arrow {
    display: none !important
} 

.testimonial-slider-section .testimonial-slider-image img {
    height: 120px !important;
    width: auto;
}

.testimonial-slider-text {
    margin-bottom: 16px;
    max-width: 390px;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    color: {{ section.settings.font_color }};
    text-align: justify;
    padding-inline: {{ section.settings.spacing_amount }}px;
}

.testimonial-slider-section {
    padding: 60px 0;
    background-color: {{ section.settings.background_color }};
}

.testimonial-slider-section .three-column-cards-col {
    margin: 0 {{ section.settings.spacing_amount }}px;
}

.js-ticker-track {
    color: {{ section.settings.text_color }};
}

@media screen and (max-width: 767px) {
    .testimonial-slider-section {
        padding: 40px 0;
    }

    .testimonial-slider-text {
    font-size: {{ section.settings.font_size_mobile }}px;
    font-weight: {{ section.settings.font_weight }};
    color: {{ section.settings.font_color }};
}

    .testimonial-slider-section .testimonial-slider-image img {
        height: 100px !important;
    }

    .testimonial-slider-section .three-column-cards-col {
        margin: 0 12px;
        max-width: 300px;
    }
}
</style>

