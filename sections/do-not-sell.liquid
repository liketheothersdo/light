{% style %}

#do-not-sell {
* {
    margin: 2%;
    box-sizing: border-box;
}

  h1 {
    font-size: 2em;
    color: #fff;
    text-wrap: pretty;
    margin-bottom: 6px;
    font-weight: 800;
  }

  h2 {
    font-size: 1.5em;
    color: #bc9a64;
    text-align: center;
    text-wrap: pretty;
    padding-bottom: 16px;
  }
  
/* Styling the body with flex container properties */
  .container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 40vh;
    background: #fff;
    /* Setting background color */
}

/* Styling for the main box */
.box {
    align-items: center;
    position: relative;
    width: 60%;
    height: fit-content;
    background: #0e0e0e;
    padding: 16px; 
}

.box .box1 span {
    color: white;
    display: flex;
    align-items: center;
    font-family: "Interstate", sans-serif;
    text-wrap: balance;
    text-align: justify;
    line-height: 1.2;
}

 .box .box2 h2 {
    display: block;
    position: relative;
    width: 90%;
    margin: 0 auto;
    padding: 10px;
    height: fit-content;
    background: #fff;
    color: #0e0e0e;
    text-align: center;
}

@media only screen and (max-width: 600px) {
  .container {
    padding-top: 6%;
    padding-bottom: 6%;
  }
  
  .box {
    width: 80%;
    font-size: 1rem;
  }

  .box1 span {
    font-size: clamp(1.25rem, 3.5vw, 1.75rem);
    color: #fff;
    text-wrap: balance;
  }

  h1 {
    font-size: 6vmin;
  }

  h2 {
    font-size: 4vmin;
    font-weight: 700;
    padding: 10px;
  }

  .box .box2 h2 {
    display: block;
    position: relative;
    width: 96%;
    padding: 10px;
    margin: 0 auto;
    height: fit-content;
    background: #fff;
    color: #0e0e0e;
    text-align: center;
}
}
}

{% endstyle %}

