{% style %}

#refund {
* {
    margin: 2%;
    box-sizing: border-box;
}

  h1 {
    font-size: 2em;
    color: #fff;
    text-wrap: pretty;
    margin-bottom: 6px;
    font-weight: 800;
  }

  h2 {
    font-size: 1.5em;
    color: #bc9a64;
    text-align: center;
    text-wrap: pretty;
    padding-bottom: 16px;
  }
  
/* Styling the body with flex container properties */
  .container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 40vh;
    background: #fff;
    /* Setting background color */
}

/* Styling for the main box */
.box {
    align-items: center;
    position: relative;
    width: 60%;
    height: fit-content;
    background: #0e0e0e;
    padding: 16px; 
}

.box .box1 span {
    color: white;
    display: flex;
    align-items: center;
    font-family: "Interstate", sans-serif;
    text-wrap: balance;
    text-align: justify;
    line-height: 1.2;
}

 .box .box2 h2 {
    display: flex;
    align-items: center;
    position: relative;
    width: 90%;
    margin: 0 auto;
    padding-top: 10px;
    height: fit-content;
    background: #fff;
    color: #0e0e0e;
    align-items: center;  
    justify-content: center;
}

@media only screen and (max-width: 600px) {
  .container {
    padding-top: 6%;
    padding-bottom: 6%;
  }
  
  .box {
    width: 80%;
    font-size: 1rem;
  }

  .box1 span {
    font-size: clamp(1.25rem, 3.5vw, 1.75rem);
    color: #fff;
  }

  h1 {
    font-size: 6vmin;
  }

  h2 {
    font-size: 4vmin;
    font-weight: 700;
    padding: 10px;
  }

  .box .box2 h2 {
    display: flex;
    align-items: center;
    position: relative;
    width: 96%;
    padding-top: 10px;
    margin: 0 auto;
    height: fit-content;
    background: #fff;
    color: #0e0e0e;
    align-items: center;  
    justify-content: center;
    
}
}

{% endstyle %}

<div id="refund" class="refund"> 
<div class="container">
<div class="box">
<h1 style="text-align: center;">Refund Policy</h1>
  <br />
<div class="box1">
<h2 style="text-align: center;">All sales are final</h2>
<div class="box1"><span><br>You may exchange your unused purchases for another treatment or package with management approval. One may exchange any remaining credit for other full-priced services provided</span></div>
<div class="box1"><span><br>If you initiate a chargeback on a payment, you agree that we may recover the amount of the chargeback, in addition to any amount charged to us by your payment method provider for such chargeback, by any means deemed permissible, including but not limited to recharging your payment method or having the amount recovered by a collection agency. 
 </span></div>
    <div class="box1"><span><br>If you feel that your payment method was used fraudulently, please contact us at info@skinspanewyork.com for immediate resolution.</span></div>
<div class="box1"><span><br>A written copy of Skin Spa New York’s refund policy is available on request</span></div>
<div>
  <br />
  <div class="box2">
<h2>When you make an online purchase or schedule your appointment with us, you are agreeing to these policies.</h2>
</div>
</div>
</div>  
</div>
</div>
</div>

